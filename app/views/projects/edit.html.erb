<% page_title "Edit project" %>
<section class="mb-8"><p class="mb-2 text-[11px] font-medium tracking-widest text-zinc-500">PROJECTS</p><h1 class="text-4xl font-semibold">Edit <%= @project.name %></h1></section>
<section class="max-w-xl rounded-xl border border-zinc-200 bg-white p-6 shadow-sm"><%= render "form", project: @project %></section>

<section class="mt-6 max-w-xl rounded-xl border border-zinc-200 bg-white p-6 shadow-sm">
  <div class="mb-5"><p class="mb-2 text-[11px] font-medium tracking-widest text-zinc-500">SERVICE BUDGETS</p><h2 class="text-xl font-semibold">Estimated hours</h2><p class="mt-2 text-sm leading-5 text-zinc-500">Assign tracked time to a service to show how much of its estimate has been used on invoices.</p></div>
  <% @project.service_budgets.order(:archived, :name).each do |budget| %>
    <%= form_with model: [@project, budget], class: "mb-3 rounded-lg border border-zinc-200 p-3" do |form| %>
      <div class="grid gap-3 sm:grid-cols-[minmax(0,1fr)_7rem_8rem]">
        <div><%= form.label :name, class: "mb-1 block text-xs text-zinc-600" %><%= form.text_field :name, required: true, class: "h-9 w-full rounded-md border-zinc-300 px-2 text-sm" %></div>
        <div><%= form.label :budget_hours, "Hours", class: "mb-1 block text-xs text-zinc-600" %><%= form.number_field :budget_hours, step: 0.25, min: 0.25, required: true, class: "h-9 w-full rounded-md border-zinc-300 px-2 text-sm" %></div>
        <div><%= form.label :cadence, class: "mb-1 block text-xs text-zinc-600" %><%= form.select :cadence, [["Project total", "project"], ["Per month", "monthly"]], {}, class: "h-9 w-full rounded-md border-zinc-300 px-2 text-sm" %></div>
      </div>
      <div class="mt-3 flex items-center justify-between gap-3"><label class="flex items-center gap-2 text-xs text-zinc-600"><%= form.check_box :archived, class: "size-4 rounded border-zinc-300 text-zinc-900" %>Archive this service</label><%= form.submit "Save", class: button_class %></div>
    <% end %>
  <% end %>
  <%= form_with model: [@project, ServiceBudget.new], class: "mt-5 border-t border-zinc-200 pt-5" do |form| %>
    <p class="mb-3 text-sm font-medium">Add service budget</p>
    <div class="grid gap-3 sm:grid-cols-[minmax(0,1fr)_7rem_8rem]">
      <div><%= form.label :name, "Service", class: "mb-1 block text-xs text-zinc-600" %><%= form.text_field :name, required: true, placeholder: "Web design", class: "h-9 w-full rounded-md border-zinc-300 px-2 text-sm" %></div>
      <div><%= form.label :budget_hours, "Hours", class: "mb-1 block text-xs text-zinc-600" %><%= form.number_field :budget_hours, step: 0.25, min: 0.25, required: true, placeholder: "12", class: "h-9 w-full rounded-md border-zinc-300 px-2 text-sm" %></div>
      <div><%= form.label :cadence, class: "mb-1 block text-xs text-zinc-600" %><%= form.select :cadence, [["Project total", "project"], ["Per month", "monthly"]], {}, class: "h-9 w-full rounded-md border-zinc-300 px-2 text-sm" %></div>
    </div>
    <div class="mt-3"><%= form.submit "Add budget", class: button_class(:dark) %></div>
  <% end %>
</section>
