<% page_title "Projects" %><section class="mb-8 flex flex-col gap-5 sm:mb-10 sm:flex-row sm:items-end sm:justify-between"><div><p class="mb-2 text-[11px] font-medium tracking-widest text-zinc-500">PROJECTS</p><h1 class="text-4xl font-semibold sm:text-5xl">Client work, organised.</h1></div><%= link_to "New project", new_project_path, class: button_class(:dark) %></section><section class="border-t border-zinc-200"><% @projects.each do |project| %><article class="grid min-h-18 grid-cols-[minmax(0,1fr)_6rem] gap-3 border-b border-zinc-200 py-3 sm:grid-cols-[minmax(13rem,1fr)_7rem_6rem_8rem] sm:items-center"><div class="grid gap-1"><strong class="font-medium"><%= project.name %></strong><span class="text-xs text-zinc-500"><%= project.client_name %><% if project.client_address.present? %> · <%= project.client_address.lines.first.strip %><% end %></span></div><div class="text-right tabular-nums"><%= money(project.hourly_rate_cents) %><small class="block text-[11px] text-zinc-500">/ hr</small></div><span class="<%= status_class(project.active? ? "active" : "archived") %>"><%= project.active? ? "Active" : "Archived" %></span><div class="flex justify-end gap-3 text-xs"><%= link_to "Edit", edit_project_path(project), class: "text-zinc-600 hover:text-zinc-900" %><%= button_to "Delete", project_path(project), method: :delete, class: "border-0 bg-transparent p-0 text-red-600 hover:text-red-800", data: { turbo_confirm: "Delete this project?" } %></div></article><% end %><% if @projects.empty? %><div class="py-7 text-zinc-500">Projects hold your rate and client details.</div><% end %></section>
