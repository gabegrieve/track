<%= form_with model: project do |form| %><% if project.errors.any? %><div class="mb-5 rounded-md border border-red-200 bg-red-50 p-3 text-red-800"><%= project.errors.full_messages.to_sentence %></div><% end %><div class="mb-4"><%= form.label :name, "Project name", class: "mb-1.5 block text-xs text-zinc-600" %><%= form.text_field :name, required: true, autofocus: true, class: "h-10 rounded-md border-zinc-300 px-3" %></div><div class="mb-4"><%= form.label :client_name, "Client name", class: "mb-1.5 block text-xs text-zinc-600" %><%= form.text_field :client_name, required: true, class: "h-10 rounded-md border-zinc-300 px-3" %></div><div class="mb-4"><%= form.label :client_address, "Client address", class: "mb-1.5 block text-xs text-zinc-600" %><%= form.text_area :client_address, rows: 3, class: "rounded-md border-zinc-300 px-3 py-2" %></div><div class="mb-4"><%= form.label :hourly_rate_cents, "Hourly rate (cents)", class: "mb-1.5 block text-xs text-zinc-600" %><%= form.number_field :hourly_rate_cents, min: 0, required: true, class: "h-10 rounded-md border-zinc-300 px-3" %><small class="mt-1 block text-xs text-zinc-500">For example, 15000 = $150.00/hr.</small></div><label class="mb-5 flex items-center gap-2 text-sm"><%= form.check_box :active, class: "size-4 rounded border-zinc-300 text-zinc-900 focus:ring-zinc-900" %>Active project</label><div class="flex gap-2"><%= form.submit class: button_class(:dark) %><%= link_to "Cancel", projects_path, class: button_class(:secondary) %></div><% end %>
