<% page_title "Time" %>
<section class="mb-8 flex flex-col gap-5 sm:mb-10 sm:flex-row sm:items-end sm:justify-between">
  <div><p class="mb-2 text-[11px] font-medium tracking-widest text-zinc-500">TIME TRACKING</p><h1 class="text-4xl font-semibold sm:text-5xl">What are you working on?</h1></div>
  <%= link_to "Add project", new_project_path, class: button_class(:secondary) if @projects.empty? %>
</section>

<% if @running_entry %>
  <section class="mb-12 flex flex-col gap-5 rounded-xl border border-green-200 bg-white p-5 shadow-sm sm:flex-row sm:items-center sm:justify-between">
    <div><p class="mb-2 text-[11px] font-medium tracking-widest text-zinc-500">RUNNING TIMER</p><h2 class="text-xl font-semibold tracking-tight"><%= @running_entry.description %></h2><p class="mt-2 text-zinc-500"><span class="mr-1.5 inline-block size-2 rounded-full bg-blue-700"></span><%= @running_entry.project.name %> · started <%= l @running_entry.started_at, format: :short %></p></div>
    <div class="flex items-center gap-4"><strong class="text-2xl font-semibold tracking-tight"><%= duration(@running_entry.display_duration_minutes) %></strong><%= button_to "Stop timer", stop_time_entry_path(@running_entry), method: :patch, class: button_class(:dark) %></div>
  </section>
<% elsif @projects.any? %>
  <section class="mb-12 rounded-xl border border-zinc-200 bg-white p-4 shadow-sm"><%= form_with url: start_time_entries_path, class: "grid gap-2 sm:grid-cols-[minmax(0,1fr)_12rem_auto]" do |form| %><%= form.text_field :description, placeholder: "What are you working on?", required: true, autofocus: true, class: "h-10 rounded-md border-zinc-300 px-3 placeholder:text-zinc-400 focus:border-zinc-900 focus:ring-zinc-900", aria: { label: "Description" } %><%= form.collection_select :project_id, @projects, :id, :name, { prompt: "Choose a project" }, required: true, class: "h-10 rounded-md border-zinc-300 px-3 focus:border-zinc-900 focus:ring-zinc-900", aria: { label: "Project" } %><%= form.submit "Start", class: button_class(:dark) %><% end %></section>
<% else %><section class="mb-12 rounded-xl border border-dashed border-zinc-300 p-7 text-zinc-500">Create a project before starting your first timer.</section><% end %>

<section class="mb-4 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between"><div><p class="mb-2 text-[11px] font-medium tracking-widest text-zinc-500">RECORDS</p><h2 class="text-xl font-semibold tracking-tight">Tracked time</h2></div><details class="relative"><summary class="cursor-pointer text-sm text-zinc-600 hover:text-zinc-900">Add manual time</summary><% if @projects.any? %><%= form_with model: @manual_entry, url: manual_time_entries_path, class: "absolute right-0 top-8 z-10 grid w-[min(42rem,90vw)] gap-2 rounded-lg border border-zinc-200 bg-white p-3 shadow-xl sm:grid-cols-[2fr_1.2fr_1.2fr_.8fr_auto]" do |form| %><%= form.text_field :description, placeholder: "Description", required: true, class: "h-9 rounded-md border-zinc-300 px-2 text-sm" %><%= form.collection_select :project_id, @projects, :id, :name, { prompt: "Project" }, required: true, class: "h-9 rounded-md border-zinc-300 px-2 text-sm" %><%= form.date_field :entry_date, value: Date.current, required: true, class: "h-9 rounded-md border-zinc-300 px-2 text-sm" %><%= form.number_field :duration_minutes, placeholder: "Minutes", min: 1, required: true, class: "h-9 rounded-md border-zinc-300 px-2 text-sm" %><%= form.submit "Add", class: button_class %><% end %><% end %></details></section>

<section class="mb-4 flex flex-wrap items-center gap-1"><% { "week" => "This week", "month" => "This month", "year" => "This year" }.each do |range, label| %><%= link_to label, root_path(range: range), class: "rounded-md px-2.5 py-1.5 text-sm #{(params[:range].presence || 'week') == range ? 'bg-zinc-200 text-zinc-900' : 'text-zinc-500 hover:bg-zinc-100 hover:text-zinc-900'}" %><% end %><%= form_with url: root_path, method: :get, class: "ml-1 flex flex-wrap items-center gap-1.5 text-xs text-zinc-500" do |form| %><%= form.hidden_field :range, value: "custom" %><%= form.date_field :start_date, value: params[:start_date], class: "h-8 rounded-md border-zinc-300 px-2 text-xs" %><span>to</span><%= form.date_field :end_date, value: params[:end_date], class: "h-8 rounded-md border-zinc-300 px-2 text-xs" %><%= form.submit "Filter", class: "cursor-pointer border-0 bg-transparent px-1 text-xs text-blue-600" %><% end %></section>

<section class="border-t border-zinc-200"><% if @time_entries.any? %><% @time_entries.each do |entry| %><article class="grid min-h-18 grid-cols-[3.5rem_minmax(0,1fr)_4rem] gap-2 border-b border-zinc-200 py-3 sm:grid-cols-[5.5rem_minmax(11rem,1fr)_5.5rem_6rem_10rem] sm:items-center sm:gap-3"><div class="font-medium"><%= entry.started_at ? entry.started_at.strftime("%-d %b") : "—" %><small class="mt-1 block text-[11px] font-normal text-zinc-500"><%= entry.started_at&.strftime("%Y") %></small></div><div class="grid gap-1"><strong class="font-medium"><%= entry.description %></strong><span class="text-xs text-zinc-500"><i class="mr-1.5 inline-block size-2 rounded-full bg-blue-700"></i><%= entry.project.name %></span></div><div class="text-right tabular-nums"><%= duration(entry.display_duration_minutes) %></div><span class="col-start-2 sm:col-auto <%= status_class(entry.billing_status) %>"><%= status_label(entry.billing_status) %></span><div class="col-start-3 row-span-2 row-start-1 grid justify-items-end gap-1 text-xs sm:col-auto sm:row-auto sm:flex sm:justify-end sm:gap-3"><%= link_to "Edit", edit_time_entry_path(entry), class: "text-zinc-600 hover:text-zinc-900" if entry.uninvoiced? && !entry.running? %><%= button_to "Start again", restart_time_entry_path(entry), class: "border-0 bg-transparent p-0 text-zinc-600 hover:text-zinc-900" unless entry.running? %><%= button_to "Delete", time_entry_path(entry), method: :delete, class: "border-0 bg-transparent p-0 text-red-600 hover:text-red-800", data: { turbo_confirm: "Delete this time entry?" } if entry.uninvoiced? %></div></article><% end %><% else %><div class="py-7 text-zinc-500">No time entries in this period.</div><% end %></section>
