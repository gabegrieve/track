<% page_title "Settings" %><section class="mb-8"><p class="mb-2 text-[11px] font-medium tracking-widest text-zinc-500">SETTINGS</p><h1 class="text-4xl font-semibol">Your invoice details.</h1><p class="mt-3 max-w-2xl leading-6 text-zinc-500">These details are copied into an invoice when it is issued, so historic invoices stay unchanged.</p></section><section class="max-w-xl rounded-xl border border-zinc-200 bg-white p-6 shadow-sm"><%= form_with model: @business_setting, url: settings_path, method: :patch do |form| %><% if @business_setting.errors.any? %><div class="mb-5 rounded-md border border-red-200 bg-red-50 p-3 text-red-800"><%= @business_setting.errors.full_messages.to_sentence %></div><% end %><div class="mb-4"><%= form.label :business_name, "Business name", class: "mb-1.5 block text-xs text-zinc-600" %><%= form.text_field :business_name, required: true, class: "h-10 rounded-md border-zinc-300 px-3" %></div><div class="mb-4"><%= form.label :business_address, "Business address", class: "mb-1.5 block text-xs text-zinc-600" %><%= form.text_area :business_address, rows: 3, required: true, class: "rounded-md border-zinc-300 px-3 py-2" %></div><div class="grid gap-4 sm:grid-cols-2"><div class="mb-4"><%= form.label :abn, "ABN", class: "mb-1.5 block text-xs text-zinc-600" %><%= form.text_field :abn, class: "h-10 rounded-md border-zinc-300 px-3" %></div><div class="mb-4"><%= form.label :email, class: "mb-1.5 block text-xs text-zinc-600" %><%= form.email_field :email, required: true, class: "h-10 rounded-md border-zinc-300 px-3" %></div></div><div class="mb-4"><%= form.label :payment_instructions, "Payment instructions", class: "mb-1.5 block text-xs text-zinc-600" %><%= form.text_area :payment_instructions, rows: 3, required: true, placeholder: "Bank name, BSB, account number…", class: "rounded-md border-zinc-300 px-3 py-2" %></div><div class="mb-5"><%= form.label :gst_rate, "GST rate (%)", class: "mb-1.5 block text-xs text-zinc-600" %><%= form.number_field :gst_rate, step: 0.01, min: 0, max: 100, required: true, class: "h-10 rounded-md border-zinc-300 px-3" %></div><%= form.submit "Save settings", class: button_class(:dark) %><% end %></section>
