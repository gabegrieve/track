<% page_title "Edit time entry" %>

<section class="mb-8">
  <p class="mb-2 text-[11px] font-medium tracking-widest text-zinc-500">TIME ENTRY</p>
  <h1 class="text-4xl font-semibold">Edit tracked time</h1>
</section>

<section class="max-w-xl rounded-xl border border-zinc-200 bg-white p-6 shadow-sm">
  <%= form_with model: @time_entry do |form| %>
    <% if @time_entry.errors.any? %>
      <div class="mb-5 rounded-md border border-red-200 bg-red-50 p-3 text-red-800"><%= @time_entry.errors.full_messages.to_sentence %></div>
    <% end %>

    <div class="mb-4">
      <%= form.label :description, class: "mb-1.5 block text-xs text-zinc-600" %>
      <%= form.text_field :description, required: true, class: "h-10 rounded-md border-zinc-300 px-3" %>
    </div>
    <div class="mb-4">
      <%= form.label :project_id, "Project", class: "mb-1.5 block text-xs text-zinc-600" %>
      <%= form.collection_select :project_id, Project.active.order(:name), :id, :name, {}, required: true, class: "h-10 rounded-md border-zinc-300 px-3" %>
    </div>
    <div class="mb-5 grid gap-4 sm:grid-cols-2">
      <div>
        <%= form.label :started_at, "Start time", class: "mb-1.5 block text-xs text-zinc-600" %>
        <%= form.datetime_local_field :started_at, required: true, class: "h-10 rounded-md border-zinc-300 px-3" %>
      </div>
      <div>
        <%= form.label :ended_at, "Stop time", class: "mb-1.5 block text-xs text-zinc-600" %>
        <%= form.datetime_local_field :ended_at, required: true, class: "h-10 rounded-md border-zinc-300 px-3" %>
      </div>
    </div>
    <p class="mb-5 text-xs text-zinc-500">Duration is recalculated from the times when you save.</p>
    <div class="flex gap-2">
      <%= form.submit "Save changes", class: button_class(:dark) %>
      <%= link_to "Cancel", root_path, class: button_class(:secondary) %>
    </div>
  <% end %>
</section>
