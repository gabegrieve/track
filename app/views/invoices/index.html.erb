<% page_title "Invoices" %><section class="mb-8 flex flex-col gap-5 sm:mb-10 sm:flex-row sm:items-end sm:justify-between"><div><p class="mb-2 text-[11px] font-medium tracking-widest text-zinc-500">INVOICES</p><h1 class="text-4xl font-semibold sm:text-5xl">Clear, simple billing.</h1></div><%= link_to "Create invoice", new_invoice_path, class: button_class(:dark) %></section><section class="border-t border-zinc-200"><% @invoices.each do |invoice| %><%= link_to invoice_path(invoice), class: "grid min-h-18 grid-cols-[minmax(0,1fr)_6rem] gap-3 border-b border-zinc-200 py-3 hover:bg-white sm:grid-cols-[minmax(13rem,1fr)_7rem_6rem] sm:items-center" do %><div class="grid gap-1"><strong class="font-medium"><%= invoice.number.presence || "Draft invoice" %></strong><span class="text-xs text-zinc-500"><%= invoice.project.name %> · <%= l(invoice.period_start, format: :long) %> – <%= l(invoice.period_end, format: :long) %></span></div><div class="text-right tabular-nums"><%= money(invoice.total_cents) %></div><span class="<%= status_class(invoice.status) %>"><%= status_label(invoice.status) %></span><% end %><% end %><% if @invoices.empty? %><div class="py-7 text-zinc-500">When your time is ready, create an invoice from a project and date range.</div><% end %></section>
