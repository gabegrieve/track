<% page_title @invoice.number.presence || "Draft invoice" %><section class="mb-8 flex flex-col gap-5 sm:mb-10 sm:flex-row sm:items-end sm:justify-between"><div><p class="mb-2 text-[11px] font-medium tracking-widest text-zinc-500"><%= @invoice.draft? ? "DRAFT INVOICE" : @invoice.number %></p><h1 class="text-4xl font-semibold sm:text-5xl"><%= @invoice.project.name %></h1><p class="mt-3 text-zinc-500"><%= l(@invoice.period_start, format: :long) %> – <%= l(@invoice.period_end, format: :long) %> · due <%= l(@invoice.due_on, format: :long) %></p></div><div class="flex flex-wrap gap-2"><% if @invoice.draft? %><%= button_to "Issue invoice", issue_invoice_path(@invoice), method: :patch, class: button_class(:dark), data: { turbo_confirm: "Issue this invoice and mark its entries pending?" } %><%= button_to "Delete draft", invoice_path(@invoice), method: :delete, class: button_class(:secondary), data: { turbo_confirm: "Delete this draft?" } %><% elsif @invoice.issued? %><%= link_to "Download PDF", pdf_invoice_path(@invoice), class: button_class(:dark) %><%= button_to "Mark paid", mark_paid_invoice_path(@invoice), method: :patch, class: button_class %><%= button_to "Void", void_invoice_path(@invoice), method: :patch, class: button_class(:secondary), data: { turbo_confirm: "Void this issued invoice and restore its entries?" } %><% else %><%= link_to "Download PDF", pdf_invoice_path(@invoice), class: button_class(:dark) %><% end %></div></section><section class="rounded-xl border border-zinc-200 bg-white p-5 shadow-sm sm:p-8"><div class="flex flex-col justify-between gap-5 border-b border-zinc-200 pb-7 sm:flex-row"><div><p class="mb-2 text-[11px] font-medium tracking-widest text-zinc-500">BILL TO</p><strong class="font-medium"><%= @invoice.draft? ? @invoice.project.client_name : @invoice.client_name %></strong><p class="mt-1 whitespace-pre-line leading-5 text-zinc-500"><%= @invoice.draft? ? @invoice.project.client_address : @invoice.client_address %></p></div><div><p class="mb-2 text-[11px] font-medium tracking-widest text-zinc-500">STATUS</p><span class="<%= status_class(@invoice.status) %>"><%= status_label(@invoice.status) %></span></div></div><div class="mt-6"><div class="hidden grid-cols-[7.5rem_minmax(10rem,1fr)_5.5rem_6.5rem_6.25rem] gap-2 border-b border-zinc-200 px-1 pb-3 text-[11px] font-medium text-zinc-500 sm:grid"><span>Date</span><span>Description</span><span class="text-right">Time</span><span class="text-right">Rate</span><span class="text-right">Amount</span></div><% @invoice_lines.each do |line| %><div class="grid grid-cols-[minmax(0,1fr)_auto] gap-x-2 gap-y-1 border-b border-zinc-200 px-1 py-3 sm:grid-cols-[7.5rem_minmax(10rem,1fr)_5.5rem_6.5rem_6.25rem] sm:gap-2"><span class="text-xs text-zinc-500"><%= l(line.entry_date, format: :short) %></span><span><%= line.description %></span><span class="text-xs text-zinc-500 sm:text-right sm:text-sm sm:text-zinc-900"><%= duration(line.duration_minutes) %></span><span class="hidden text-right sm:block"><%= money(line.hourly_rate_cents) %>/hr</span><span class="col-start-2 row-start-1 text-right font-medium sm:col-auto sm:row-auto"><%= money(line.amount_cents) %></span></div><% end %></div><div class="ml-auto mt-6 max-w-70"><p class="flex justify-between py-1.5 text-zinc-600"><span>Subtotal</span><strong><%= money(@invoice.subtotal_cents) %></strong></p><p class="flex justify-between py-1.5 text-zinc-600"><span>GST (<%= @invoice.gst_rate %>%)</span><strong><%= money(@invoice.tax_cents) %></strong></p><p class="mt-2 flex justify-between border-t border-zinc-900 pt-3 text-lg font-semibold"><span>Total</span><strong><%= money(@invoice.total_cents) %></strong></p></div></section><% if @invoice.draft? %><p class="mt-4 text-xs text-zinc-500">Issuing snapshots your business and client details, locks these entries, and changes their status to pending.</p><% end %>
