<% page_title "Create invoice" %><section class="mb-8"><p class="mb-2 text-[11px] font-medium tracking-widest text-zinc-500">INVOICES</p><h1 class="text-4xl font-semibold">Prepare an invoice</h1><p class="mt-3 max-w-2xl leading-6 text-zinc-500">All completed, uninvoiced entries in the selected project and period will be included in a reviewable draft.</p></section><section class="mb-4 flex flex-wrap items-center gap-1"><%= link_to "This month", new_invoice_path(period: "this_month"), class: "rounded-md px-2.5 py-1.5 text-sm #{params[:period] != 'last_month' ? 'bg-zinc-200 text-zinc-900' : 'text-zinc-500 hover:bg-zinc-100'}" %><%= link_to "Last month", new_invoice_path(period: "last_month"), class: "rounded-md px-2.5 py-1.5 text-sm #{params[:period] == 'last_month' ? 'bg-zinc-200 text-zinc-900' : 'text-zinc-500 hover:bg-zinc-100'}" %><span class="ml-1 text-xs text-zinc-500">or choose a custom range below</span></section><section class="max-w-xl rounded-xl border border-zinc-200 bg-white p-6 shadow-sm"><%= form_with model: @invoice do |form| %><div class="mb-4"><%= form.label :project_id, "Project", class: "mb-1.5 block text-xs text-zinc-600" %><%= form.collection_select :project_id, @projects, :id, :name, { prompt: "Choose a project" }, required: true, class: "h-10 rounded-md border-zinc-300 px-3" %></div><div class="grid gap-4 sm:grid-cols-2"><div class="mb-4"><%= form.label :period_start, "From", class: "mb-1.5 block text-xs text-zinc-600" %><%= form.date_field :period_start, required: true, class: "h-10 rounded-md border-zinc-300 px-3" %></div><div class="mb-4"><%= form.label :period_end, "To", class: "mb-1.5 block text-xs text-zinc-600" %><%= form.date_field :period_end, required: true, class: "h-10 rounded-md border-zinc-300 px-3" %></div></div><div class="mb-5"><%= form.label :due_on, "Due date", class: "mb-1.5 block text-xs text-zinc-600" %><%= form.date_field :due_on, required: true, class: "h-10 rounded-md border-zinc-300 px-3" %></div><div class="flex gap-2"><%= form.submit "Create draft", class: button_class(:dark) %><%= link_to "Cancel", invoices_path, class: button_class(:secondary) %></div><% end %></section>
